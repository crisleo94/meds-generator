# ==========================================
# Variables de Entorno para Producción (Django)
# ==========================================

# 1. Seguridad básica (Genera una clave aleatoria para prod)
DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria-en-produccion

# 2. Modo Depuración (Siempre False en producción)
DJANGO_DEBUG=False

# 3. Dominios / IPs permitidos (separados por coma)
DJANGO_ALLOWED_HOSTS=midominio.com,www.midominio.com,192.168.1.100

# 4. Orígenes confiables para CSRF (CRÍTICO si usas HTTPS detrás de Nginx/Cloudflare/Caddy)
DJANGO_CSRF_TRUSTED_ORIGINS=https://midominio.com,https://www.midominio.com
